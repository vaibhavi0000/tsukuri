{
  "rewrites": [
    { "source": "/api/webhooks/xpressbees", "destination": "/api/webhooks/xpressbees" },
    { "source": "/api/uploads/(.*)", "destination": "/uploads/$1" },
    { "source": "/uploads/(.*)", "destination": "/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
